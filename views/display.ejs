<!doctype html>
<html lang="en">

    <%- include('header'); -%>

    <h2 class="title">ECS Example Game</h2>

    <div id="game">
        <div v-if="connected">
            <p>Phase: {{phase}}</p>
            <p>Round: {{round}}</p>
            <h3>Players ({{players.length}}/8)</h3>
            <ul>
                <li v-for = "person in players" :key = "person.username">
                    {{person.username}}
                    <span v-if = "person.isAdmin"> (Admin)</span>

                </li>
            </ul>
            <p>Audience: {{audienceCount}}</p>
            <ul id="chat">
                <li v-for="message in messages">{{message}}</li>
            </ul>
        </div>
        <div v-else>
            <p>Connecting...</p>
        </div>
        <p>Join the game at: <a :href="joinUrl">{{joinUrl}}</a></p>
    </div>

    <%- include('footer'); -%>

</html>
